{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/app.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run tests (test_app.py)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "test_app",
        "-v"
      ],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}