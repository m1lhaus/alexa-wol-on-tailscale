# Tailscale OAuth client secret (or auth key)
# Format: tskey-client-... or tskey-auth-...
TS_AUTHKEY=tskey-auth-...

# Tailscale hostname for this node
TS_HOSTNAME=wol

# Tailscale ACL tags to advertise (comma-separated, must exist in your Tailscale ACL policy)
TS_TAGS=tag:container,tag:wol

# Timezone
TZ=Europe/Prague

# ─── Wake-on-LAN ─────────────────────────────────────────────────────────────

# Long random secret that Voice Monkey will include in the POST body.
# Generate with e.g.: openssl rand -hex 32
# Example POST body from Voice Monkey: {"token":"<some_token>"}
WOL_TOKEN=

# MAC address of the machine to wake up (colon or dash separated)
WOL_MAC=AA:BB:CC:DD:EE:FF

# Broadcast address on your LAN (usually <subnet>.255)
WOL_BROADCAST=192.168.1.255

# UDP port to listen for WOL requests (default: 9)
WOL_PORT=9  

# Optional: debug mode (1 to enable, 0 to disable). In debug mode, the server will log 
# all incoming requests, even invalid ones.
WOL_DEBUG=0

# Optional: per-connection inactivity timeout in seconds (default: 5)
# Connections that send no data within this window are closed — limits slowloris attacks.
WOL_CONN_TIMEOUT=5


# ─── macvlan network ──────────────────────────────────────────────────────────

# Host network interface to attach the macvlan to (e.g. eth0, eno1, enp3s0)
# Find with: ip -br link show  (look for the interface with your LAN IP)
#        or: ip route | grep default  (shows "dev <iface>")
MACVLAN_PARENT=eth0

# Your LAN subnet in CIDR notation
# Find with: ip -br addr show <iface>  (e.g. "192.168.0.5/24" → subnet is "192.168.0.0/24")
#        or: ip route | grep <iface>   (look for the "proto kernel" route)
LAN_SUBNET=192.168.0.0/24

# Your LAN default gateway
# Find with: ip route | grep default  (e.g. "default via 192.168.0.1")
LAN_GATEWAY=192.168.0.1

# Static IP assigned to the ts-wol container on the LAN
# Must be an unused address within LAN_SUBNET, outside your router's DHCP range.
# Verify it is free with: ping -c1 192.168.1.X  (should get no reply)
# Check DHCP range in your router's admin UI to avoid conflicts.
CONTAINER_IP=192.168.1.X
